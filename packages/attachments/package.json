{
  "name": "@knowledge-studio/attachments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Safe vault attachment copying, relative links, missing and orphan reports.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@knowledge-studio/shared": "workspace:*"
  }
}
