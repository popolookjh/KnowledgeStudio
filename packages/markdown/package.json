    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
  }
}
