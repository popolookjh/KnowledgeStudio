{
  "name": "@knowledge-studio/markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markdown pipeline: frontmatter extraction, outline, sanitized HTML rendering.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
