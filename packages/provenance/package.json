{
  "name": "@knowledge-studio/provenance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned local provenance records and deterministic citation helpers.",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" } },
  "files": ["dist"],
  "scripts": { "build": "tsc -b", "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"" },
  "dependencies": {
    "@knowledge-studio/metadata": "workspace:*",
    "@knowledge-studio/shared": "workspace:*",
    "@knowledge-studio/vault": "workspace:*"
  }
}
