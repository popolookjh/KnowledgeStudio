{
  "name": "@knowledge-studio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Knowledge Studio desktop application: Electron shell with a React renderer.",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "tsc -b && concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron ."
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@knowledge-studio/ai-config": "workspace:*",
    "@knowledge-studio/attachments": "workspace:*",
    "@knowledge-studio/bases": "workspace:*",
    "@knowledge-studio/canvas": "workspace:*",
    "@knowledge-studio/change-feed": "workspace:*",
    "@knowledge-studio/git": "workspace:*",
    "@knowledge-studio/history": "workspace:*",
    "@knowledge-studio/links": "workspace:*",
    "@knowledge-studio/markdown": "workspace:*",
    "@knowledge-studio/mcp": "workspace:*",
    "@knowledge-studio/pdf-annotations": "workspace:*",
    "@knowledge-studio/mcp-host": "workspace:*",
    "@knowledge-studio/metadata": "workspace:*",
    "@knowledge-studio/plugin-host": "workspace:*",
    "@knowledge-studio/provenance": "workspace:*",
    "@knowledge-studio/rtl": "workspace:*",
    "@knowledge-studio/search": "workspace:*",
    "@knowledge-studio/shared": "workspace:*",
    "@knowledge-studio/tags": "workspace:*",
    "@knowledge-studio/vault": "workspace:*",
    "@knowledge-studio/web-clipper": "workspace:*",
    "@knowledge-studio/zotero": "workspace:*",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.34.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.31.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "pdfjs-dist": "6.3.289",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "license": "MIT"
}
